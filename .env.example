# =============================================================
# Trading Framework Configuration
# =============================================================

# Upstox API tokens
UPSTOX_ACCESS_TOKEN=your_access_token_here

# Sandbox access token (generate from Upstox Developer Apps > Sandbox)
UPSTOX_SANDBOX_TOKEN=your_sandbox_token_here

# Trading mode: sandbox (default), paper, or live
TRADING_MODE=sandbox

# Nifty futures instrument token (update with current month's contract)
NIFTY_INSTRUMENT_TOKEN=NSE_FO|NIFTY

# SAFETY LOCK for live trading (must be "yes" to enable live mode)
# WARNING: Setting this to "yes" will allow REAL orders with REAL money
CONFIRM_LIVE=no
